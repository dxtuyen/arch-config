# ── KHÔNG commit ───────────────────────────────────────────
# Kết quả symlink của stow (đã có trong .gitignore tương lai)
*.stow-backup

# File SINH RA, không viết tay. Nguồn duy nhất là config/session-env.sh
# — install.sh sinh ra file này. Commit vào sẽ thành 2 nơi phải đồng
# bộ, đúng thứ ta vừa bỏ.
config/environment.d/

# Secret
#
# ⛔ KHÔNG BAO GIỜ commit API key vào đây. Repo này public: ai cũng đọc
#    được file push lên, và lịch sử git là VĨNH VIỄN — xoá ở commit sau
#    không gỡ được, phải `git filter-repo` hoặc xoá cả repo.
#
#    GitHub có push protection chặn sẵn, nhưng key ĐÃ được gửi lên máy
#    chủ GitHub để quét dù push bị từ chối → vẫn phải rotate.
#
#    Cách đúng: copy tay ~/.config/quick-lang/api.key sang máy mới, hoặc
#    đặt biến môi trường GEMINI_API_KEY (quick-lang đọc cả hai).
#    Một lần copy còn hơn lộ key vĩnh viễn.
config/quick-lang/
*.key
*.pem
id_*

# Dữ liệu ngoài repo
Pictures/
Books/
Downloads/
Apps/
VMs/
.cache/

# Editor / hệ điều hành
*.swp
*~
.DS_Store
result
result-*
.vim/
nvim.log
