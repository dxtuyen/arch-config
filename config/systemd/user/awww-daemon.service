# awww-daemon — đặt ảnh nền. Fork của swww: có chuyển cảnh mượt khi
# đổi ảnh (fade 1.5s).
#
# ⭐ LÝ DO DUY NHẤT để giữ awww thay vì dùng `output * bg` của Sway:
#   Sway đổi nền là CẮT CỨNG, không có hiệu ứng. awww cho fade.
#   Nếu bạn không thấy khác biệt, xoá hẳn phần ảnh nền này — xem
#   ghi chú "BỎ awww" trong ~/.config/sway/config.
#
# awww giữ trạng thái ảnh ở ~/.cache/awww, nên đăng nhập lại vẫn ra
# đúng ảnh phiên trước. Việc "giữ hay random" do wallpaper-init.service
# quyết định, không phải script này.

[Unit]
Description=awww wallpaper daemon
After=sway-session.target
PartOf=sway-session.target
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/usr/bin/awww-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=sway-session.target
