#!/usr/bin/env bash
# Thông báo âm lượng / mic / đèn nền, có thanh tiến trình.
# Gắn cả phím cứng (XF86*) lẫn app điều khiển media qua MPRIS.
#
#   media-notify volume-up | volume-down | volume-mute
#   media-notify mic-mute
#   media-notify brightness-up | brightness-down
set -eu

# flock để bấm phím liên tục không đè thông báo nhau.
if [ "${MEDIA_NOTIFY_LOCKED:-}" != 1 ]; then
  exec env MEDIA_NOTIFY_LOCKED=1 flock "${XDG_RUNTIME_DIR:?}/media-notify.lock" "$0" "$@"
fi

# Thay (replace) thông báo cũ của cùng loại thay vì chồng lên nhau.
notify_replace() {
  local name="$1" id_file replace_id notification_id
  shift
  id_file="${XDG_RUNTIME_DIR:?}/media-notify-${name}.id"
  replace_id=""

  if [ -r "$id_file" ]; then
    read -r replace_id < "$id_file" || true
    case "$replace_id" in
      *[!0-9]*|"") replace_id="" ;;
    esac
  fi

  if [ -n "$replace_id" ]; then
    notification_id="$(notify-send -p -r "$replace_id" "$@")"
  else
    notification_id="$(notify-send -p "$@")"
  fi

  case "$notification_id" in
    *[!0-9]*|"") ;;
    *) printf '%s\n' "$notification_id" > "$id_file" ;;
  esac
}

notify_volume() {
  local status volume icon
  status="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
  volume="$(printf '%s\n' "$status" | awk '{ printf "%d", ($2 * 100) + 0.5 }')"
  case "$status" in
    *MUTED*)
      notify_replace volume -a volume -i "audio-volume-muted" -h int:value:0 -t 2000 "Volume" "Muted"
      ;;
    *)
      if   [ "$volume" -ge 70 ]; then icon="audio-volume-high"
      elif [ "$volume" -ge 30 ]; then icon="audio-volume-medium"
      elif [ "$volume" -gt 0  ]; then icon="audio-volume-low"
      else                           icon="audio-volume-muted"
      fi
      notify_replace volume -a volume -i "$icon" -h "int:value:$volume" -t 2000 "Volume" "${volume}%"
      ;;
  esac
}

notify_microphone() {
  case "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)" in
    *MUTED*)
      notify_replace microphone -a volume -i "microphone-sensitivity-muted" -t 2000 "Microphone" "Muted" ;;
    *)
      notify_replace microphone -a volume -i "audio-input-microphone" -t 2000 "Microphone" "On" ;;
  esac
}

notify_brightness() {
  local bright_raw bright_val
  bright_raw="$(brightnessctl -m | cut -d, -f4)"
  bright_val="${bright_raw%%%}"
  notify_replace brightness -a brightness -i "display-brightness" -h "int:value:$bright_val" -t 2000 "Brightness" "$bright_raw"
}

case "${1:?missing action}" in
  volume-up)      wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; notify_volume ;;
  volume-down)    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-;     notify_volume ;;
  volume-mute)    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle;    notify_volume ;;
  mic-mute)       wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle;  notify_microphone ;;
  brightness-up)  brightnessctl set +10%;                       notify_brightness ;;
  brightness-down) brightnessctl set 10%-;                       notify_brightness ;;
  *) echo "usage: media-notify {volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down}" >&2; exit 1 ;;
esac
