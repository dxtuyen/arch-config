#!/usr/bin/env bash
# Gọi bởi swayidle sau 900s không thao tác.
#   Đang dùng pin → ngủ luôn.
#   Đang cắm sạc → trồng watcher, rút sạc giữa lúc thì khoá + ngủ.
#
# ⚠️ Chạy cảnh báo "discharging" trên laptop là BUG của một số driver.
#    Thử trước 3 giây, không thấy pin rút thì coi như đang cắm sạc.
set -u

# Phiên Focus đang chạy → không ngủ (END_TIME là wall-clock nên ngủ sẽ
# làm timer nhảy cóc). Chính `study` cũng dừng swayidle khi phiên chạy;
# kiểm tra này là lưới an toàn thứ hai.
if pgrep -f "study daemon" >/dev/null 2>&1; then
  exit 0
fi

is_discharging() {
  local bat
  for bat in /sys/class/power_supply/BAT*; do
    [ -e "$bat/status" ] || continue
    [ "$(cat "$bat/status" 2>/dev/null)" = "Discharging" ] && return 0
  done
  return 1
}

if is_discharging; then
  exec systemctl suspend
fi

# Cắm sạc → watcher: rút sạc khi vẫn idle thì khoá + ngủ.
# (swayidle chỉ chạy timeout 900 MỘT LẦN mỗi chu kỳ, nên không tự bắn lại.)
if ! pgrep -f idle-suspend-ac-watch >/dev/null 2>&1; then
  "$HOME/.local/bin/idle-suspend-ac-watch" >/dev/null 2>&1 &
fi
