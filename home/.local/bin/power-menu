#!/usr/bin/env bash
# Menu nguồn. Super+Shift+P.
set -u

# Cố ý KHÔNG có mục Hibernate: máy không có swap trên đĩa (chỉ zram trong
# RAM, tắt máy là mất). Ngủ suspend-to-RAM là đủ dùng — xem
# etc/kernel/cmdline.
MENU="⏻ Tắt máy
↻ Khởi động lại
⏾ Ngủ
🔒 Khoá màn hình
⚡ Power profile
↺ Nạp lại session
⏏ Thoát Sway"

choice="$(printf '%s\n' "$MENU" | rofi -dmenu -i -p "Power" \
  -mesg "Chọn hành động rồi Enter")"

case "$choice" in
  "⏻ Tắt máy")
    notify-send -a power -i "system-shutdown" -t 2000 "Power" "Đang tắt máy…"
    exec systemctl poweroff ;;
  "↻ Khởi động lại")
    notify-send -a power -i "system-reboot" -t 2000 "Power" "Đang khởi động lại…"
    exec systemctl reboot ;;
  "⏾ Ngủ")
    notify-send -a power -i "system-suspend" -t 2000 "Power" "Đang ngủ…"
    exec systemctl suspend ;;
  "🔒 Khoá màn hình")      exec ~/.local/bin/lock-screen ;;
  "⚡ Power profile")      exec ~/.local/bin/power-profile-menu ;;
  "↺ Nạp lại session")    exec ~/.local/bin/refresh-session ;;
  "⏏ Thoát Sway")
    exec swaynag -t warning -m 'Thoát Sway?' -B 'Thoát' 'swaymsg exit' ;;
esac
