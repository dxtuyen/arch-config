#!/usr/bin/env bash
# Bật/tắt touchpad. Super+Alt+T.
#
# ⚠️ Khi bật lại, script ÁP LẠI toàn bộ tham số touchpad — phải khớp
#    khối `input type:touchpad` trong ~/.config/sway/config. Nếu sửa
#    tham số ở đó thì sửa cả ở đây, nếu không sẽ thấy hành vi lạ chỉ
#    sau khi bật/tắt.
set -u

# Hỏi Sway trực tiếp thay vì tin file trạng thái (file có thể lệch sau
# khi restart Sway).
current="$(swaymsg -t get_inputs 2>/dev/null \
  | jq -r '[.[] | select(.type == "touchpad") | .libinput.send_events][0] // empty' 2>/dev/null)"
[ -n "$current" ] || current="enabled"

apply_touchpad_config() {
  swaymsg input type:touchpad pointer_accel 0.6
  swaymsg input type:touchpad accel_profile adaptive
  swaymsg input type:touchpad natural_scroll enabled
  swaymsg input type:touchpad scroll_method two_finger
  swaymsg input type:touchpad tap enabled
  swaymsg input type:touchpad drag enabled
  swaymsg input type:touchpad dwt enabled
  # events bật CUỐI CÙNG, sau khi mọi thiết lập khác sẵn sàng.
  swaymsg input type:touchpad events enabled
}

case "$current" in
  enabled)
    swaymsg input type:touchpad events disabled
    label="Touchpad đã tắt"
    ;;
  disabled)
    apply_touchpad_config
    label="Touchpad đã bật"
    ;;
  *)
    notify-send -a toggle-touchpad -t 3000 "Touchpad" "Không đọc được trạng thái: $current"
    exit 1
    ;;
esac

notify-send -a toggle-touchpad -i "input-touchpad" -t 2000 "Touchpad" "$label"
